# Copy to deploy/.env and fill in.

# --- Caddy ---
# Public domain whose DNS A/AAAA record points at this server (needed for TLS).
DOMAIN=games.example.com

# --- App (better-auth) ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=https://games.example.com
DATABASE_URL=postgres://user:password@db-host:5432/coozygames

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Wisp (optional) ---
# Leave empty when Wisp is proxied on the same origin at /wisp/ (recommended).
# Set only if Wisp runs on another origin, e.g. wss://wisp.example.com/wisp/
NEXT_PUBLIC_WISP_URL=
