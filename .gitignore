/node_modules
proxy-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.agents

# testing
/coverage

# next.js
/.next/
/out/

# game thumbnail disk cache
/image-cache/

